@model SalesManagement.Models.Product

@{
    ViewData["Title"] = "Yeni Ürün";
}

<h2>Yeni Ürün Ekle</h2>

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div class="mb-3">
                <label class="form-label">Kategori</label>
                @Html.DropDownListFor(m => m.CategoryId, ViewBag.Categories as SelectList, "-- Seçiniz --", new { @class = "form-control" })
            </div>
            <div class="mb-3">
                <label class="form-label">Ürün Adı</label>
                @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
            </div>
            <div class="mb-3">
                <label class="form-label">Resim URL</label>
                @Html.TextBoxFor(m => m.ImageSrc, new { @class = "form-control" })
            </div>
            <div class="mb-3">
                <label class="form-label">Satış Fiyatı</label>
                @Html.TextBoxFor(m => m.Salesprice, new { @class = "form-control" })
            </div>
            <button type="submit" class="btn btn-success">Kaydet</button>
            <a href="/Product/Index" class="btn btn-secondary">Geri</a>
        </form>
    </div>
</div>