@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="text-center py-5">
    <h1 class="display-4 fw-bold">SalesManagement</h1>
    <p class="lead text-muted">Satış, Satın Alım ve Stok Yönetimi</p>
    <hr class="my-4" />
</div>

<div class="row g-4 justify-content-center">
    <div class="col-md-3">
        <div class="card shadow-sm h-100 border-0">
            <div class="card-body text-center p-4">
                <div class="fs-1 mb-3">📦</div>
                <h5 class="card-title">Ürünler</h5>
                <p class="card-text text-muted">Ürün ekle, güncelle ve listele.</p>
                <a asp-controller="Product" asp-action="Index" class="btn btn-primary w-100">Git</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm h-100 border-0">
            <div class="card-body text-center p-4">
                <div class="fs-1 mb-3">💰</div>
                <h5 class="card-title">Satış</h5>
                <p class="card-text text-muted">Yeni satış ekle ve satışları takip et.</p>
                <a asp-controller="Sales" asp-action="Index" class="btn btn-success w-100">Git</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm h-100 border-0">
            <div class="card-body text-center p-4">
                <div class="fs-1 mb-3">🛒</div>
                <h5 class="card-title">Satın Alım</h5>
                <p class="card-text text-muted">Yeni alım ekle ve alımları takip et.</p>
                <a asp-controller="Purchase" asp-action="Index" class="btn btn-warning w-100">Git</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm h-100 border-0">
            <div class="card-body text-center p-4">
                <div class="fs-1 mb-3">📊</div>
                <h5 class="card-title">Raporlar</h5>
                <p class="card-text text-muted">Satış ve stok raporlarını görüntüle.</p>
                <a asp-controller="Report" asp-action="SalesReport" class="btn btn-info w-100">Git</a>
            </div>
        </div>
    </div>
</div>